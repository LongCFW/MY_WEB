# Cấu hình Hệ thống
APP_NAME=Ecostore
APP_ENV=local
APP_DEBUG=true
APP_URL=http://ecostore.test

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ecostore
DB_USERNAME=root
DB_PASSWORD=

# Cấu hình gửi mail (PHPMailer - SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost/MY_WEB/public/auth/googleCallback

# Cấu hình đường dẫn gốc của website (Lưu ý dấu / ở cuối)
BASE_URL=http://localhost/MY_WEB/public/





